    "audit_findings": [
        {
            "key": "registry_alignment_gap",
            "severity": "high",
            "finding": "ReportSavedViewController uses private static report label/route maps instead of ReportSavedViewRegistry.",
            "impact": "New registered reports can have saved views but may show raw keys or fail apply/open links in the management page until static maps are updated.",
            "evidence": {
                "missing_label_keys": [
                    "financial-dashboard",
                    "index",
                    "profit-loss",
                    "sales-invoice-collection-follow-ups",
                    "sales-invoice-collections",
                    "saved-view-candidates"
                ],
                "missing_route_keys": [
                    "financial-dashboard",
                    "index",
                    "profit-loss",
                    "sales-invoice-collection-follow-ups",
                    "sales-invoice-collections",
                    "saved-view-candidates"
                ]
            }
        },
        {
            "key": "index_action_density",
            "severity": "medium",
            "finding": "The saved view index table exposes many actions in one table cell.",
            "impact": "As report count and saved views grow, scanability and mobile usability can degrade.",
            "evidence": {
                "actions": [
                    "open",
                    "edit",
                    "apply",
                    "duplicate",
                    "make_default",
                    "delete",
                    "delete_all"
                ]
            }
        },
        {
            "key": "edit_filter_mutation_risk",
            "severity": "medium",
            "finding": "The edit page copy says filters are read-only, but the page renders editable filter inputs and update accepts filters.",
            "impact": "Users can modify filter payloads without report-specific validation or clear UX expectations.",
            "evidence": {
                "edit_view_has_filter_inputs": true,
                "controller_accepts_filters_array": true
            }
        },
        {
            "key": "ownership_guard_present",
            "severity": "positive",
            "finding": "Saved view actions call authorizeSavedView before per-record operations.",
            "impact": "User ownership is protected for edit, update, apply, duplicate, make default, and delete operations.",
            "evidence": {
                "authorize_method_present": true
            }
        }
    ],
    "phase_66b_recommendations": [
        "Replace ReportSavedViewController static REPORT_LABELS and REPORT_ROUTES with ReportSavedViewRegistry lookups.",
        "Add coverage proving every registered saved view report has a management label and apply/open route.",
        "Decide whether edit filters are truly editable. If yes, add report-aware validation. If no, render filters read-only.",
        "Add grouped action layout or action menu for saved view rows to reduce table density.",
        "Keep existing ownership guard behavior and add explicit tests for cross-user forbidden access for every management action."
    ]
}
