  "manual_refresh_success_rate_contract": {
    "purpose": "Define a client-side derived percentage representing validated manual refresh successes divided by accepted manual refresh attempts.",
    "target_partial": "resources/views/reports/saved-views/partials/share-activity-retention-audit-metrics-health.blade.php",
    "element": {
      "id": "retention-audit-metrics-health-manual-refresh-success-rate",
      "element": "span",
      "prefix": "Manual refresh success rate:",
      "initial_text": "Not available",
      "aria_live": "off"
    },
    "source_counters": {
      "attempts_variable": "manualRefreshAttempts",
      "successes_variable": "manualRefreshSuccesses",
      "failures_variable": "manualRefreshFailures",
      "attempts_are_denominator": true,
      "successes_are_numerator": true,
      "failures_are_not_directly_used": true
    },
    "calculation": {
      "formula": "(manualRefreshSuccesses / manualRefreshAttempts) * 100",
      "zero_attempts_text": "Not available",
      "minimum_percentage": 0,
      "maximum_percentage": 100,
      "maximum_fraction_digits": 1,
      "suffix": "%",
      "locale_aware_formatting": true,
      "fallback_formatting": true
    },
    "update_rules": {
      "render_after_manual_attempt_increment": true,
      "render_after_manual_success_increment": true,
      "render_after_manual_failure_increment": true,
      "initial_automatic_request_does_not_change_rate": true,
      "ignored_concurrent_manual_request_does_not_change_rate": true,
      "page_memory_only": true,
      "persistent_storage_used": false
    },
    "examples": [
