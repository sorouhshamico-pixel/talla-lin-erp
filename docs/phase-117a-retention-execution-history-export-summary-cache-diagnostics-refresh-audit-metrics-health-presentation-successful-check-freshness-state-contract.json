  "freshness_state_contract": {
    "purpose": "Define a client-side freshness state for the most recent validated healthy Audit Metrics Health check using the existing successful check age state without changing endpoint payloads, authorization, request frequency, persistence, or backend behavior.",
    "target_partial": "resources/views/reports/saved-views/partials/share-activity-retention-audit-metrics-health.blade.php",
    "element": {
      "id": "retention-audit-metrics-health-successful-check-freshness",
      "element": "span",
      "prefix": "Successful check freshness:",
      "initial_text": "Unavailable",
      "aria_live": "off"
    },
    "state_values": {
      "fresh": {
        "text": "Fresh",
        "minimum_age_minutes": 0,
        "maximum_age_minutes_inclusive": 14
      },
      "stale": {
        "text": "Stale",
        "minimum_age_minutes": 15
      },
      "unavailable": {
        "text": "Unavailable",
        "used_when_no_valid_success_date": true
      }
    },
    "source": {
      "state_variable": "lastSuccessfulCheckAt",
      "current_time_argument": "currentTime",
      "age_minutes_calculation": "Math.floor(Math.max(0, currentTime.getTime() - lastSuccessfulCheckAt.getTime()) / 60000)",
      "server_timestamp_used": false,
      "payload_timestamp_used": false,
      "response_header_timestamp_used": false,
      "rendered_age_text_parsed": false
    },
    "update_rules": {
      "request_start_clears_previous_value": false,
      "validated_healthy_response_updates": true,
      "validated_unhealthy_response_updates": false,
      "http_error_response_updates": false,
      "network_failure_updates": false,
      "json_parse_failure_updates": false,
      "payload_validation_failure_updates": false,
      "ignored_concurrent_request_updates": false,
      "updates_with_same_completed_date_as_successful_check": true,
      "updates_once_per_validated_healthy_request": true,
      "background_timer_updates": false,
      "polling_updates": false
    },
    "visual_state": {
      "data_attribute_target": "retention-audit-metrics-health-successful-check-freshness",
      "data_attribute": "data-freshness-state",
      "allowed_values": [
