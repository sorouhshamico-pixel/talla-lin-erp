  "manual_refresh_last_outcome_contract": {
    "purpose": "Define a client-side presentation field showing the most recent accepted manual refresh outcome.",
    "target_partial": "resources/views/reports/saved-views/partials/share-activity-retention-audit-metrics-health.blade.php",
    "element": {
      "id": "retention-audit-metrics-health-manual-refresh-last-outcome",
      "element": "span",
      "prefix": "Last manual refresh outcome:",
      "initial_text": "Not available",
      "aria_live": "polite",
      "data_attribute": "data-outcome-state",
      "initial_state": "unavailable"
    },
    "states": {
      "unavailable": {
        "text": "Not available",
        "when": "before any accepted manual refresh completes"
      },
      "healthy": {
        "text": "Healthy",
        "when": "accepted manual refresh returns a valid payload with healthy=true"
      },
      "unhealthy": {
        "text": "Requires attention",
        "when": "accepted manual refresh returns a valid payload with healthy=false"
      },
      "failed": {
        "text": "Failed",
        "when": "accepted manual refresh ends in HTTP, network, parsing, or payload validation failure"
      }
    },
    "state_management": {
      "state_variable": "lastManualRefreshOutcome",
      "initial_value": "unavailable",
      "renderer": "renderLastManualRefreshOutcome",
      "setter": "setLastManualRefreshOutcome",
      "client_memory_only": true,
      "persistent_storage_used": false
    },
    "update_rules": {
      "validated_healthy_updates_to_healthy": true,
      "validated_unhealthy_updates_to_unhealthy": true,
      "manual_failure_updates_to_failed": true,
      "initial_automatic_request_does_not_update": true,
      "ignored_concurrent_manual_request_does_not_update": true,
      "manual_attempt_increment_does_not_update": true,
      "update_occurs_once_per_completed_manual_request": true
    },
    "legacy_contract": {
      "load_health_signature": "const loadHealth = async () => {",
      "refresh_listener": "refresh.addEventListener('click', loadHealth);",
      "initial_load": "loadHealth();",
      "must_remain_unchanged": true
    },
    "compatibility": {
